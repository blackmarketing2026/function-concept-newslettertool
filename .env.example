# ============================================================
# Email Marketing System - Environment Configuration
# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# Niemals ".env" ins Git-Repository committen!
# ============================================================

APP_NAME="Email Marketing System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Europe/Berlin
APP_KEY=change-me-to-a-random-32-byte-string

# --- Datenbank -------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=email_marketing
DB_USERNAME=db_user
DB_PASSWORD=db_password
DB_CHARSET=utf8mb4

# --- SMTP / Versand ---------------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=smtp_user
MAIL_PASSWORD=smtp_password
MAIL_FROM_ADDRESS=newsletter@example.com
MAIL_FROM_NAME="Example Newsletter"
MAIL_BOUNCE_ADDRESS=bounce-handler@example.com

# --- DKIM ---------------------------------------------------------
DKIM_ENABLED=true
DKIM_DOMAIN=example.com
DKIM_SELECTOR=newsletter
DKIM_PRIVATE_KEY_PATH=storage/dkim/private.key

# --- Admin API ------------------------------------------------------
API_TOKEN=change-me-generate-a-secure-random-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- Compliance / DSGVO --------------------------------------------
IMPRESSUM_URL=https://example.com/impressum
DATENSCHUTZ_URL=https://example.com/datenschutz
DOUBLE_OPT_IN=true
AUDIT_LOG_RETENTION_MONTHS=24

# --- Monitoring -----------------------------------------------------
ALERT_EMAIL=admin@example.com
ALERT_THRESHOLD_FAILURES=0.1
